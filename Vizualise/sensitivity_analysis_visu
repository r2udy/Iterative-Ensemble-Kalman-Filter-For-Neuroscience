# MAIN
# ══════════════════════════════════════════════════════

def main():
    all_signed_finals = {}
    all_svals         = {}

    # ── A. OAT sweeps ───────────────────────────────
    for sweep_name in OAT_SWEEPS:
        print(f"\n{'='*55}")
        print(f"  OAT  ·  {sweep_name}")
        print(f"{'='*55}")

        arrays, svals = load_oat(sweep_name)
        if arrays is None:
            print(f"  Skipping {sweep_name} (data not found)")
            continue

        # Reconstruct signed bias from saved cmro2_mean + sweep_values
        signed = _signed(arrays, svals,
                         cmro2_true_override=sweep_name if sweep_name == "cmro2_true"
                         else None)

        all_signed_finals[sweep_name] = signed[:, -1]
        all_svals[sweep_name]         = svals

        sub = os.path.join(OUT_PATH, "oat", sweep_name)
        os.makedirs(sub, exist_ok=True)

        # Save signed bias array for this sweep
        np.save(os.path.join(sub, "signed_bias.npy"), signed)

        # 1. Convergence: true vs est + signed bias + posterior σ
        fig = fig_convergence(sweep_name, svals, arrays, signed)
        fig.savefig(os.path.join(sub, "signed_bias_convergence.png"),
                    dpi=200, bbox_inches="tight")
        plt.close(fig)
        print(f"  ✓ signed_bias_convergence.png")

        # 2. Final-iteration signed bar + true vs est scatter with σ
        fig = fig_final_signed_bar(sweep_name, svals, arrays, signed)
        fig.savefig(os.path.join(sub, "signed_bias_final.png"),
                    dpi=200, bbox_inches="tight")
        plt.close(fig)
        print(f"  ✓ signed_bias_final.png")

        # 3. Heatmap (diverging, sweep × iteration)
        fig = fig_signed_heatmap(sweep_name, svals, signed)
        fig.savefig(os.path.join(sub, "signed_bias_heatmap.png"),
                    dpi=200, bbox_inches="tight")
        plt.close(fig)
        print(f"  ✓ signed_bias_heatmap.png")

        # 4. True vs estimated scatter (identity line)
        fig = fig_true_vs_est_scatter(sweep_name, svals, arrays, signed)
        fig.savefig(os.path.join(sub, "true_vs_est_scatter.png"),
                    dpi=200, bbox_inches="tight")
        plt.close(fig)
        print(f"  ✓ true_vs_est_scatter.png")

        # 5. Residual panel
        fig = fig_residual_distribution(sweep_name, svals, signed)
        fig.savefig(os.path.join(sub, "residual_panel.png"),
                    dpi=200, bbox_inches="tight")
        plt.close(fig)
        print(f"  ✓ residual_panel.png")

        # Console summary
        meta = SWEEP_META[sweep_name]
        print(f"\n  {'Sweep value':<22} {'true':>7} {'est':>7} {'signed bias':>12} {'post σ':>8}")
        print(f"  {'-'*58}")
        for i, v in enumerate(svals):
            true_v = v if sweep_name == "cmro2_true" else DEF_CMRO2
            est_v  = arrays["cmro2_mean"][i, -1]
            sb     = signed[i, -1]
            std_v  = arrays["cmro2_std"][i, -1]
            flag   = "  ← underest" if sb > 0.1 else ("  ← overest" if sb < -0.1 else "")
            print(f"  {meta[1](v):<22} {true_v:>7.3f} {est_v:>7.3f} {sb:>+12.4f} {std_v:>8.4f}{flag}")

    # ── B. Summary figure ───────────────────────────
    if all_signed_finals:
        print("\n--- Summary figure ---")
        fig = fig_summary_signed(all_signed_finals, all_svals)
        fig.savefig(os.path.join(OUT_PATH, "SUMMARY_signed_bias.png"),
                    dpi=200, bbox_inches="tight")
        plt.close(fig)
        print(f"  ✓ SUMMARY_signed_bias.png")

    # ── C. Cross-sweep signed heatmaps ──────────────
    for (pA, pB, title) in CROSS_PAIRS:
        print(f"\n  CROSS  ·  {pA}_x_{pB}")
        arrays = load_cross(pA, pB)
        if arrays is None:
            continue

        valsA = arrays.get("vals_A")
        valsB = arrays.get("vals_B")
        if valsA is None or valsB is None:
            print(f"  [WARN] vals_A/vals_B missing, skipping cross {pA}_x_{pB}")
            continue

        fig = fig_cross_signed(pA, valsA, pB, valsB, arrays, title)
        if fig is not None:
            sub = os.path.join(OUT_PATH, "cross", f"{pA}_x_{pB}")
            os.makedirs(sub, exist_ok=True)
            fig.savefig(os.path.join(sub, "signed_bias_cross.png"),
                        dpi=200, bbox_inches="tight")
            plt.close(fig)
            print(f"  ✓ signed_bias_cross.png")

    print(f"\n✅  All done — output in {OUT_PATH}")


if __name__ == "__main__":
    main()