def fig_summary_signed(all_signed_finals, all_svals):
    """
    2×3 grid: one horizontal bar chart per OAT sweep at final iteration.
    Mirrors the absolute bias summary but shows sign.
    """
    fig, axes = plt.subplots(2, 3, figsize=(16, 9))
    axes = axes.flatten()

    for idx, sweep_name in enumerate(OAT_SWEEPS):
        ax    = axes[idx]
        meta  = SWEEP_META[sweep_name]
        svals = all_svals[sweep_name]
        finals= all_signed_finals[sweep_name]
        x     = np.arange(len(svals))
        clrs  = ["#D85A30" if v > 0 else "#378ADD" for v in finals]

        bars = ax.bar(x, finals, color=clrs, edgecolor="k",
                      linewidth=0.5, alpha=0.85)
        ax.axhline(0, color="k", lw=1.2, ls="--")
        ax.bar_label(bars, fmt="%+.3f", fontsize=6, padding=2)
        ax.set_xticks(x)
        ax.set_xticklabels([meta[1](v) for v in svals],
                           rotation=28, ha="right", fontsize=7)
        ax.set_xlabel(meta[0], fontsize=8)
        ax.set_ylabel("Signed bias  [µmol/cm³/min]", fontsize=8)
        ax.set_title(sweep_name, fontsize=9, fontweight="bold")
        ax.grid(True, axis="y", alpha=0.3)

    for idx in range(len(OAT_SWEEPS), len(axes)):
        axes[idx].set_visible(False)

    fig.suptitle("Signed CMRO2 bias at Final Iteration  —  All OAT Sweeps\n"
                 "Orange = underestimate  |  Blue = overestimate  |  Zero line = perfect",
                 fontsize=13, fontweight="bold")
    plt.tight_layout()
    return fig


